# 接入你自己的 LLM（OpenAI 兼容协议）。
# 也可以不改这里，直接在网页左下角「⚙ AI」里填写（推荐）。
# 复制本文件为 .env 后填写即可生效。

# 示例：DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-chat

# 其他常见服务：
#   OpenAI      base=https://api.openai.com/v1                          model=gpt-4o-mini
#   Kimi        base=https://api.moonshot.cn/v1                         model=moonshot-v1-8k
#   通义千问     base=https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
#   本地 Ollama  base=http://localhost:11434/v1                          model=qwen2.5 （key 随便填）
